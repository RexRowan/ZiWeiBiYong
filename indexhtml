<script>
(function () {
  'use strict';

  /* ───── 結構：沿用原站「主頁／書冊／文／書畫／聯繫」 ───── */
  var L = function (t, id) { return { t: t, id: id }; };
  var TREE = [
    L('主頁', 'home'),
    { t: '書冊', kids: [L('俯瞰', 'fukan')] },
    { t: '文', kids: [
      { t: '奏', kids: [L('策', 'ce')] },
      { t: '議', kids: [L('原', 'yuan'), L('辨', 'bian'), L('論', 'lun'), L('說', 'shuo')] },
      L('銘', 'ming'), L('駢', 'pian'),
      { t: '詩詞歌賦', kids: [
        { t: '詩', kids: [L('古詩', 'gushi'), L('近體詩', 'jintishi'), L('新詩', 'xinshi')] },
        { t: '風騷', kids: [L('風', 'feng'), L('騷', 'sao')] },
        L('詞', 'ci'), L('賦', 'fu'),
        { t: '樂府', kids: [L('古樂府', 'guyuefu'), L('新樂府', 'xinyuefu')] },
        { t: '序跋', kids: [L('序', 'xu'), L('跋', 'ba')] },
        L('對聯', 'duilian')
      ] },
      { t: '小說', kids: [L('傳奇', 'chuanqi')] },
      { t: '注疏', kids: [L('注', 'zhu'), L('疏', 'shu')] },
      L('偈', 'ji'), L('散文', 'sanwen')
    ] },
    { t: '書畫', kids: [L('書', 'shufa'), L('畫', 'hua')] },
    L('聯繫', 'lianxi')
  ];

  /* ───── 各體釋名 ───── */
  var INFO = {
    ce: '策，古代臣下就政事陳述謀略、對答策問的文體，常見於奏疏與科舉策論，重在切中時務、條理分明。',
    yuan: '原，推究事物本源的議論文體，自根柢處說起，立論明斷。韓愈《原道》《原毀》為其典範。',
    bian: '辨，辨析是非真偽、廓清名實的議論文體，多針對一事一說，逐層辯駁。韓愈《諱辨》為其代表。',
    lun: '論，就事理加以剖析、推演而下斷語的文體，講求邏輯與氣勢。賈誼《過秦論》為其名篇。',
    shuo: '說，以陳述己見、闡發事理為主的文體，題材多小而寄意深，常借物起興。韓愈《師說》、周敦頤《愛蓮說》皆屬此類。',
    ming: '銘，原為刻於器物以自警或紀功的文字，後成韻文一體，篇幅短小，句式整飭。劉禹錫《陋室銘》為其代表。',
    pian: '駢，即駢體文，以對偶、四六句式、聲律與用典見長，盛於六朝。王勃《滕王閣序》、庾信《哀江南賦序》為其名篇。',
    gushi: '古詩，又稱古體詩，不拘平仄與句數，長短、押韻皆較自由。《古詩十九首》為其源頭，漢魏六朝以至唐宋皆有佳作。',
    jintishi: '近體詩，又稱今體詩，成熟於唐代，包括律詩與絕句，講究平仄、對仗與押韻，格律嚴整。',
    xinshi: '新詩，以白話寫成的詩，興起於五四新文化運動前後，不拘舊體格律，重在意象與節奏。',
    feng: '風，指《詩經》十五國風，是各地的民間歌謠，反映當時的生活與情感，為中國詩歌的源頭之一。',
    sao: '騷，以屈原《離騷》為代表的楚辭體，句式參差，多用「兮」字，想像瑰麗，抒情深切，與《詩經》並稱「風騷」。',
    ci: '詞，配合樂曲而作，依詞牌填寫，句式長短錯落，盛於宋代。有婉約、豪放諸般風格，李煜、柳永、蘇軾、李清照皆為大家。',
    fu: '賦，鋪陳事物、抒寫情志的文體，介於詩與文之間，講究辭采與排比，漢代最盛。司馬相如《子虛賦》、班固《兩都賦》為其代表。',
    guyuefu: '古樂府，漢魏六朝由樂府機關採集或創作的歌辭，多敘事，貼近民間。《木蘭詩》、《孔雀東南飛》為其名篇。',
    xinyuefu: '新樂府，唐代詩人不沿用古題、即事名篇的樂府詩，倡導者為元稹、白居易，旨在反映民生疾苦。',
    xu: '序，說明著作緣起、體例與旨趣的文字，亦有贈別、宴集時所作之序。王羲之《蘭亭集序》為其代表。',
    ba: '跋，附於書籍、字畫、碑帖之後，記述來歷、考訂真偽或抒發感想的短文。',
    duilian: '對聯，上下兩聯字數相等、詞性相對、平仄相諧的文字，可題於楹柱門庭，亦可抒懷言志。',
    chuanqi: '傳奇，原指唐代文言短篇小說，如《鶯鶯傳》、《霍小玉傳》；後世亦用以稱明清長篇戲曲，如《牡丹亭》。',
    zhu: '注，對經典文句中的字詞、名物、典故所作的解釋，目的在疏通原文。',
    shu: '疏，在舊注的基礎上進一步申說、補充，兼釋經文與前注。孔穎達《五經正義》為其代表。',
    ji: '偈，源自梵語「伽陀」，是佛經中的韻語，常以四句為一偈，用以讚頌或闡明教義，後世禪師亦以偈示悟。',
    sanwen: '散文，不拘韻律與駢偶、行文自由的文章，與韻文、駢文相對。唐宋八大家之文為古文典範。',
    shufa: '陳列書法作品。',
    hua: '陳列繪畫作品。'
  };

  /* ───── 篇目：在對應欄目下新增 { title, by, lines:[…] } 即可上架 ───── */
  var ENTRIES = {
    feng: [{ title: '關雎（節錄）', by: '《詩經．周南》', sample: true,
      lines: ['關關雎鳩，在河之洲。', '窈窕淑女，君子好逑。'] }],
    sao: [{ title: '離騷（節錄）', by: '屈原', sample: true,
      lines: ['帝高陽之苗裔兮，朕皇考曰伯庸。', '攝提貞於孟陬兮，惟庚寅吾以降。'] }],
    jintishi: [{ title: '春望', by: '杜甫', sample: true,
      lines: ['國破山河在，城春草木深。', '感時花濺淚，恨別鳥驚心。', '烽火連三月，家書抵萬金。', '白頭搔更短，渾欲不勝簪。'] }],
    ci: [{ title: '虞美人', by: '李煜', sample: true,
      lines: ['春花秋月何時了，往事知多少。', '小樓昨夜又東風，故國不堪回首月明中。', '雕欄玉砌應猶在，只是朱顏改。', '問君能有幾多愁，恰似一江春水向東流。'] }]
  };

  /* ───── 展平 ───── */
  var leaves = [];
  (function walk(nodes, path) {
    nodes.forEach(function (n) {
      if (n.kids) walk(n.kids, path.concat(n.t));
      else leaves.push({ id: n.id, t: n.t, path: path });
    });
  })(TREE, []);
  var byId = {};
  leaves.forEach(function (l) { byId[l.id] = l; });
  var content = leaves.filter(function (l) { return INFO[l.id]; });

  function esc(s) {
    return String(s).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }
  var BIRD = '<svg aria-hidden="true" viewBox="0 0 120 140"><use href="#bird"/></svg>';

  /* ───── 導覽 ───── */
  function linkHTML(n) { return '<a href="#' + n.id + '">' + n.t + '</a>'; }
  function subHTML(kids) {
    var out = '', run = '';
    function flush() { if (run) { out += '<div class="links">' + run + '</div>'; run = ''; } }
    kids.forEach(function (k) {
      if (k.kids) {
        flush();
        out += '<div class="sub"><span class="sh">' + k.t + '</span><div class="links">' + k.kids.map(linkHTML).join('') + '</div></div>';
      } else run += linkHTML(k);
    });
    flush();
    return out;
  }
  function megaHTML(node) {
    var cols = [], run = [];
    node.kids.forEach(function (k) {
      if (k.kids) {
        if (run.length) { cols.push({ leaves: run }); run = []; }
        cols.push({ node: k });
      } else run.push(k);
    });
    if (run.length) cols.push({ leaves: run });
    return '<div class="mega-in">' + cols.map(function (c) {
      if (c.leaves) return '<div class="col"><div class="links">' + c.leaves.map(linkHTML).join('') + '</div></div>';
      var wide = c.node.kids.some(function (k) { return k.kids; }) ? ' wide' : '';
      return '<div class="col' + wide + '"><h3>' + c.node.t + '</h3>' + subHTML(c.node.kids) + '</div>';
    }).join('') + '</div>';
  }

  var nav = document.getElementById('nav');
  var navList = document.getElementById('navList');
  var menuBtn = document.getElementById('menuBtn');
  navList.innerHTML = TREE.map(function (n) {
    return n.kids
      ? '<li class="has"><button type="button" class="tl" aria-expanded="false">' + n.t + '</button><div class="mega">' + megaHTML(n) + '</div></li>'
      : '<li><a class="tl" href="#' + n.id + '">' + n.t + '</a></li>';
  }).join('');

  function closeMenus() {
    Array.prototype.forEach.call(navList.querySelectorAll('li.open'), function (li) {
      li.classList.remove('open');
      var b = li.querySelector('button.tl');
      if (b) b.setAttribute('aria-expanded', 'false');
    });
  }
  function closeAll() {
    closeMenus();
    nav.classList.remove('open');
    menuBtn.setAttribute('aria-expanded', 'false');
  }
  function markActive(id) {
    Array.prototype.forEach.call(nav.querySelectorAll('a'), function (a) {
      if (a.getAttribute('href') === '#' + id) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    Array.prototype.forEach.call(navList.children, function (li) {
      li.classList.toggle('on', !!li.querySelector('[aria-current]'));
    });
  }

  /* ───── 頁面 ───── */
  var view = document.getElementById('view');
  var current = null;

  function entryHTML(e) {
    return '<article class="entry"><h3>' + esc(e.title) + '</h3>' +
      '<p class="by">' + esc(e.by) + (e.sample ? '<span class="tag">範例</span>' : '') + '</p>' +
      '<div class="verse-wrap"><div class="verse">' +
      e.lines.map(function (l) { return '<p>' + esc(l) + '</p>'; }).join('') +
      '</div></div><button type="button" class="vtoggle" aria-pressed="false">直排</button></article>';
  }
  function emptyHTML() {
    return '<div class="empty">' + BIRD + '<p class="e1">此欄待錄</p><p class="e2">新作入藏後，將列於此處。</p></div>';
  }

  function homeHTML() {
    var recent = [];
    content.forEach(function (l) {
      (ENTRIES[l.id] || []).forEach(function (e) { recent.push({ e: e, l: l }); });
    });
    var rows = recent.map(function (r) {
      return '<a class="row" href="#' + r.l.id + '"><span class="rt">' + esc(r.e.title) +
        (r.e.sample ? '<span class="tag">範例</span>' : '') + '</span><span class="rc">' + r.l.path.join('．') + '．' + r.l.t +
        '</span><span class="rb">' + esc(r.e.by) + '</span></a>';
    }).join('');
    return '<section class="plaque" aria-label="門匾"><p class="kicker">中國文學　漢學　古文</p>' +
      '<h1>紫微辟雍</h1><span class="rule"></span><p class="motto">以文會友，以友輔仁。</p></section>' +
      '<section class="intro"><p>本站依文體編次：自奏議、銘駢，至詩詞歌賦、小說、注疏、偈與散文，另設書畫一欄。</p>' +
      '<a class="btn" href="#fukan">俯瞰全站</a></section>' +
      '<section class="recent"><h2 class="sec">近錄</h2>' + (rows || emptyHTML()) +
      '<p class="note">標「範例」者為示意之公版古籍篇目，供版面展示，日後可由新作替換。</p></section>';
  }

  function ovLeaf(n) {
    var c = (ENTRIES[n.id] || []).length;
    return '<a class="ovl" href="#' + n.id + '"><span>' + n.t + '</span><i>' + (c ? c + ' 篇' : '待錄') + '</i></a>';
  }
  function ovBody(kids) {
    var out = '', run = '';
    function fl() { if (run) { out += '<div class="ovlinks">' + run + '</div>'; run = ''; } }
    kids.forEach(function (k) {
      if (k.kids) { fl(); out += '<div class="ovg"><h3>' + k.t + '</h3>' + ovBody(k.kids) + '</div>'; }
      else run += ovLeaf(k);
    });
    fl();
    return out;
  }
  function fukanHTML() {
    var tops = TREE.filter(function (n) { return n.kids && (n.t === '文' || n.t === '書畫'); });
    return '<div class="crumbs"><a href="#home">主頁</a><i>›</i><span>書冊</span><i>›</i><span aria-current="page">俯瞰</span></div>' +
      '<h2 class="ph">俯瞰</h2>' +
      tops.map(function (t) { return '<section class="ov"><h2 class="ovh">' + t.t + '</h2>' + ovBody(t.kids) + '</section>'; }).join('');
  }

  function leafHTML(l) {
    var es = ENTRIES[l.id] || [];
    var i = content.indexOf(l), prev = content[i - 1], next = content[i + 1];
    var crumbs = '<a href="#home">主頁</a>' + l.path.map(function (p) { return '<i>›</i><span>' + p + '</span>'; }).join('') +
      '<i>›</i><span aria-current="page">' + l.t + '</span>';
    return '<div class="page"><div class="crumbs">' + crumbs + '</div>' +
      '<h2 class="ph">' + l.t + '</h2>' +
      '<div class="dfn"><b>釋名</b><p>' + INFO[l.id] + '</p></div>' +
      (es.length ? es.map(entryHTML).join('') : emptyHTML()) +
      '<div class="pager">' +
      (prev ? '<a href="#' + prev.id + '"><small>上一欄</small>' + prev.t + '</a>' : '<span></span>') +
      (next ? '<a class="nx" href="#' + next.id + '"><small>下一欄</small>' + next.t + '</a>' : '<span></span>') +
      '</div></div>';
  }

  function lianxiHTML() {
    return '<div class="page"><div class="crumbs"><a href="#home">主頁</a><i>›</i><span aria-current="page">聯繫</span></div>' +
      '<h2 class="ph">聯繫</h2>' +
      '<div class="dfn"><b>以文會友</b><p>歡迎同道論文談藝。</p></div>' +
      '<div class="empty">' + BIRD + '<p class="e1">聯繫方式待公布</p></div></div>';
  }

  function norm(id) {
    return (id === 'home' || id === 'fukan' || id === 'lianxi' || (byId[id] && INFO[id])) ? id : 'home';
  }
  function render(id, scroll) {
    id = norm(id);
    current = id;
    view.innerHTML = id === 'home' ? homeHTML()
      : id === 'fukan' ? fukanHTML()
      : id === 'lianxi' ? lianxiHTML()
      : leafHTML(byId[id]);
    markActive(id);
    closeAll();
    if (scroll) window.scrollTo(0, 0);
  }
  function go(id) {
    try { if (location.hash !== '#' + id) location.hash = id; } catch (e) { /* 忽略 */ }
    render(id, true);
  }

  /* ───── 事件 ───── */
  document.addEventListener('click', function (e) {
    var t = e.target;
    if (!t.closest) return;
    var a = t.closest('a[href^="#"]');
    if (a) { e.preventDefault(); go(a.getAttribute('href').slice(1)); return; }
    var tl = t.closest('button.tl');
    if (tl) {
      var li = tl.parentNode, was = li.classList.contains('open');
      closeMenus();
      if (!was) { li.classList.add('open'); tl.setAttribute('aria-expanded', 'true'); }
      return;
    }
    var vt = t.closest('.vtoggle');
    if (vt) {
      var verse = vt.parentNode.querySelector('.verse');
      var on = verse.classList.toggle('v');
      vt.setAttribute('aria-pressed', on ? 'true' : 'false');
      vt.textContent = on ? '橫排' : '直排';
      return;
    }
    if (t.closest('#menuBtn')) {
      var open = nav.classList.toggle('open');
      menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      return;
    }
    if (!t.closest('#nav')) closeMenus();
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });
  window.addEventListener('hashchange', function () {
    var id = norm((location.hash || '#home').slice(1));
    if (id !== current) render(id, true);
  });

  render((location.hash || '#home').slice(1), false);
})();
</script>

</body></html>
